import React, { useState } from 'react';
import dayjs from 'dayjs';
import ListPageComp from './common/ListPageComp';
import type { FormConfig } from './common/ListPageComp';

const allData: any[] = {{{formatJson mockData}}};

const {{componentName}}: React.FC = () => {
  const [data, setData] = useState<any[]>(allData);

  // 查询函数
  const handleSearch = (values: Record<string, any>) => {
    console.log('search values:', values);
    let result = allData;

    const keys = Object.keys(values);
    keys.map((key: any) => {
      result = result.filter((d) => d[key].includes(values[key]));
    });

    setData(result);
  };

  return (
    <div>
      <ListPageComp
        formConfig={formConfigs}
        columns={columns}
        dataSource={data}
        onSearch={handleSearch}
    />
    </div>
  );
}

export default {{componentName}};


/** 表单配置 */
const formConfigs: FormConfig = {
    fields: [
  {{#each formconfigs}}
    {
      type: "{{type}}",
      label: "{{label}}",
      name: "{{name}}",
      placeholder: '请输入{{label}}',
      {{#ifEquals type "Select"}}
      options: {{{formatJson options}}},
      {{else}}
      {{/ifEquals}}
      {{#ifEquals type "Select"}}
      format: 'YYYY-MM-DD',
      {{else}}
      {{/ifEquals}}
    },
  {{/each}}
],};


/** 表格列配置 */
const columns = [
    {{#each tableColumns}}
    {
      title: "{{label}}",
      dataIndex: "{{name}}",
      key: "{{name}}",
      {{!-- {{#formatAlign name}}
      align: 'center',
      {{else}}
      align: 'left',
      {{/if}} --}}

    },
    {{/each}}
];

