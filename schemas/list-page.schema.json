{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "List Page Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageName",
    "componentName",
    "searchFields",
    "tableColumns",
    "toolbarActions",
    "rowActions",
    "api"
  ],
  "properties": {
    "pageName": {
      "type": "string",
      "minLength": 1,
      "description": "页面名称"
    },
    "componentName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "React 或 Vue 组件名称"
    },
    "searchFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/searchField"
      }
    },
    "tableColumns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tableColumn"
      }
    },
    "toolbarActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "rowActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "api": {
      "$ref": "#/$defs/api"
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "searchField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "label",
        "type"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "input",
            "select",
            "multipleSelect",
            "date",
            "daterange",
            "number",
            "numberRange"
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "defaultValue": {},
        "width": {
          "type": "integer",
          "minimum": 80
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "label",
        "type"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "image",
            "avatar",
            "money",
            "number",
            "percent",
            "date",
            "datetime",
            "tag",
            "link",
            "boolean"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 40
        },
        "fixed": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "sortable": {
          "type": "boolean"
        },
        "ellipsis": {
          "type": "boolean"
        },
        "enumMap": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "primary",
            "default",
            "link",
            "danger"
          ]
        },
        "confirm": {
          "type": "boolean"
        },
        "permission": {
          "type": "string"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list",
        "method",
        "pagination"
      ],
      "properties": {
        "list": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "pagination": {
          "type": "boolean"
        },
        "pageParam": {
          "type": "string"
        },
        "pageSizeParam": {
          "type": "string"
        },
        "totalField": {
          "type": "string"
        }
      }
    }
  }
}